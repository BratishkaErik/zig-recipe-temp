# Generated by zig-recipe {{ generator_version }}

EAPI=8
{%- if not use_zbs_packages and has_zbs_entries %}

declare -g -r -A ZBS_DEPENDENCIES=(
{%- for dep in always_tarballs %}
	[{{ dep.filename }}]='{{ dep.url }}'
{%- endfor %}
{%- if conditional_tarballs %}
{%- if always_tarballs %}
{{ "" }}
{%- endif %}
	# Conditional dependencies:
{%- for dep in conditional_tarballs %}
	[{{ dep.filename }}]='{{ dep.url }}' # {{ dep.used_in | use_condition }}
{%- endfor %}
{%- endif %}
{%- if unused_tarballs and unused_deps != 'drop' %}
{%- if always_tarballs or conditional_tarballs %}
{{ "" }}
{%- endif %}
	# Not used in any analyzed pass:
{%- for dep in unused_tarballs %}
	{% if unused_deps == 'comment' %}# {% endif %}[{{ dep.filename }}]='{{ dep.url }}'
{%- endfor %}
{%- endif %}
{%- if tarball_tarball %}
{%- if always_tarballs or conditional_tarballs or (unused_tarballs and unused_deps != 'drop') %}
{{ "" }}
{%- endif %}
	# Some Git dependencies could not be converted to tarball URLs.
	# Host this archive somewhere and add its URL to SRC_URI:
	# {{ tarball_tarball }}
{%- for dep in git_commits %}
	[{{ dep.filename }}]=''
{%- endfor %}
{%- endif %}
)
{%- endif %}
{%- if needs_llvm %}

# C/C++ sources detected; verify if LLVM backend is required
ZIG_NEEDS_LLVM=1
{%- else %}
{{ "" }}
{%- endif %}
ZIG_SLOT="{{ zig_slot }}"
inherit zig

DESCRIPTION="{{ summary or 'TODO' }}"
HOMEPAGE="{{ homepage }}"
{%- if use_zbs_packages and has_zbs_packages %}

declare -g -r -A ZBS_PACKAGES=(
{%- for entry in always_pkg_entries %}
{%- for line in entry.lines %}
{{ line }}
{%- endfor %}
{%- endfor %}
{%- if conditional_pkg_entries %}
{%- if always_pkg_entries %}
{{ "" }}
{%- endif %}
	# Conditional dependencies:
{%- for entry in conditional_pkg_entries %}
{%- for line in entry.lines %}
{{ line }}
{%- endfor %}
{%- endfor %}
{%- endif %}
{%- if unused_pkg_entries %}
{%- if always_pkg_entries or conditional_pkg_entries %}
{{ "" }}
{%- endif %}
	# Not used in any analyzed pass:
{%- for entry in unused_pkg_entries %}
{%- for line in entry.lines %}
{{ line }}
{%- endfor %}
{%- endfor %}
{%- endif %}
)
{%- endif %}
{%- if use_zbs_packages and git_commits %}

{%- if tarball_tarball %}
# Some Git dependencies could not be converted to tarball URLs.
# Host this archive somewhere and add its URL to SRC_URI:
# {{ tarball_tarball }}
{%- endif %}
declare -g -r -a ZBS_BUNDLED_PACKAGES=(
{%- for dep in git_commits %}
	{{ dep.filename }}
{%- endfor %}
)
{%- endif %}

SRC_URI="
{%- if src_uri_entries %}
{%- for uri in src_uri_entries %}
	{{ uri }}
{%- endfor %}
{%- else %}
	# TODO: add project source URL
{%- endif %}
{%- if use_zbs_packages %}
{%- if tarball_tarball %}
	# Host this archive somewhere and add its URL here:
	# {{ tarball_tarball }}
{%- endif %}
{%- for entry in always_pkg_entries %}
	${ZBS_PACKAGES[{{ entry.alias }}]}
{%- endfor %}
{%- if unused_deps == 'keep' %}
{%- for entry in unused_pkg_entries %}
	${ZBS_PACKAGES[{{ entry.alias }}]}
{%- endfor %}
{%- endif %}
{%- for flag, aliases in conditional_src_uri_groups %}
{%- if aliases | length == 1 %}
	{{ flag }}? ( ${ZBS_PACKAGES[{{ aliases[0] }}]} )
{%- else %}
	{{ flag }}? (
{%- for alias in aliases %}
		${ZBS_PACKAGES[{{ alias }}]}
{%- endfor %}
	)
{%- endif %}
{%- endfor %}
{%- else %}
{%- if has_active_tarballs %}
	${ZBS_DEPENDENCIES_SRC_URI}
{%- endif %}
{%- if tarball_tarball %}
	# Host this archive somewhere and add its URL here:
	# {{ tarball_tarball }}
{%- endif %}
{%- endif %}
"

LICENSE="{{ license }}"
SLOT="0"
KEYWORDS="{{ keywords }}"
{%- if iuse %}
IUSE="{{ iuse | join(' ') }}"
{%- endif %}
{%- if restrict_test %}
RESTRICT="!test? ( test )"
{%- endif %}
{%- if system_libraries or find_programs %}
{{ "" }}
{%- if system_libraries %}
# Detected system libraries:
{%- for lib in always_libraries %}
# * {{ lib.name }}{% if lib.pkg_config_hint %} ({{ lib.pkg_config_hint }}){% endif %}, used by: {{ lib.used_by | library_users }}.
{%- endfor %}
{%- for lib in conditional_libraries %}
# * {{ lib.name }} ({{ lib.used_in | use_condition }}{% if lib.pkg_config_hint %}, {{ lib.pkg_config_hint }}{% endif %}), used by: {{ lib.used_by | library_users }}.
{%- endfor %}
{%- endif %}
{%- if find_programs %}
{%- if system_libraries %}
{{ "" }}
{%- endif %}
# Detected build-time tools:
{%- for prog in always_programs %}
# * {{ prog.names | join(' | ') }}
{%- endfor %}
{%- for prog in conditional_programs %}
# * {{ prog.names | join(' | ') }} ({{ prog.used_in | use_condition }})
{%- endfor %}
{%- endif %}
{%- endif %}
{%- if has_configure_body %}

src_configure() {
	local my_zbs_args=(
	{%- for arg in base_zbs_args %}
		{{ arg }}
	{%- endfor %}
	{%- for arg in variant_zbs_args %}
		{{ arg }}
	{%- endfor %}
	{%- if remaining_options %}
		{%- if base_zbs_args or variant_zbs_args %}
{{ "" }}
		# Other project build options:
		{%- else %}
		# Project build options:
		{%- endif %}
		{%- for opt in remaining_options %}
{{ "" }}
		{%- if opt.description %}
		{%- for line in opt.description | wrap_lines(70) %}
		# {{ line }}
		{%- endfor %}
		{%- endif %}
		# -D{{ opt.name }}=[{{ opt | option_type }}]
		{%- endfor %}
	{%- endif %}
	{%- if enabled_integrations %}
		{%- if base_zbs_args or variant_zbs_args or remaining_options %}
{{ "" }}
		{%- endif %}
		{%- for si in enabled_integrations %}
		-fsys={{ si.name }}
		{%- endfor %}
	{%- endif %}
	{%- if disabled_integrations %}
		{%- if base_zbs_args or variant_zbs_args or remaining_options or enabled_integrations %}
{{ "" }}
		{%- endif %}
		# Disabled by default even with --system (check if intentional):
		{%- for si in disabled_integrations %}
		-fsys={{ si.name }}
		{%- endfor %}
	{%- endif %}
	)
{%- for flag_name, on_args, off_args in variant_if_blocks %}

	if use {{ flag_name }}; then
		my_zbs_args+=( {{ on_args | join(' ') }} )
	{%- if off_args %}
	else
		my_zbs_args+=( {{ off_args | join(' ') }} )
	{%- endif %}
	fi
{%- endfor %}

	zig_src_configure
}
{%- endif %}